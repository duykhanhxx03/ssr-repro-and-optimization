+def load_ssr_checkpoint(
+    model_path: str,
+    *,
+    device: str | None = None,
+    token_scope: str | None = None,
+) -> SSR:
+    """Load a saved SSR checkpoint (Transformer + trained SparseAutoencoder).
+
+    ``SSR(model_name_or_path=...)`` builds a *fresh* SAE (random weights, 4*hidden
+    latents) and ignores ``config_sentence_transformers.json``; this loader restores
+    the trained SAE from the module listed in ``modules.json`` and the ColBERT settings
+    (prefixes, query/document length, query expansion, skiplist) saved with it.
+    """
+    import json
+    from pathlib import Path
+
+    root = Path(model_path)
+    modules = json.loads((root / "modules.json").read_text(encoding="utf-8"))
+    sae_dir = next(
+        (m["path"] for m in modules if m["type"].endswith("SparseAutoencoder")),
+        "1_SparseAutoencoder",
+    )
+    transformer = Transformer(str(root))
+    sae = SparseAutoencoder.load(str(root), subfolder=sae_dir)
+    sae_cfg = json.loads((root / sae_dir / "config.json").read_text(encoding="utf-8"))
+    if token_scope is not None:
+        sae.token_scope = token_scope
+    elif "token_scope" not in sae_cfg:
+        # Token-level SSR SAEs are trained on non-[CLS] tokens (docs/training.md).
+        sae.token_scope = "non-cls"
+
+    st_cfg_path = root / "config_sentence_transformers.json"
+    st_cfg = json.loads(st_cfg_path.read_text(encoding="utf-8")) if st_cfg_path.is_file() else {}
+    keys = (
+        "query_prefix",
+        "document_prefix",
+        "query_length",
+        "document_length",
+        "do_query_expansion",
+        "attend_to_expansion_tokens",
+        "skiplist_words",
+    )
+    model = SSR(
+        modules=[transformer, sae],
+        device=device,
+        **{k: st_cfg[k] for k in keys if k in st_cfg},
+    )
+    model.eval()
+    return model
+
+
 def build_ssr(
     model_name_or_path: str,
     *,
